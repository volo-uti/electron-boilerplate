{
  "name": "electron-boilerplate",
  "productName": "Electron Boilerplate",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Electron desktop app template: Forge with Vite, React, TanStack Router, use-intl, Tailwind 4, shadcn/ui (Base UI), lint-enforced process and layer boundaries.",
  "license": "MIT",
  "author": "Volo",
  "main": ".vite/build/main.cjs",
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "dev": "electron-forge start",
    "build": "electron-forge package",
    "lint": "eslint .",
    "fmt": "prettier --write .",
    "fmt:check": "prettier --check .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "index": "node scripts/agent-index.mjs",
    "check:index": "node scripts/agent-index.mjs --check",
    "check:locales": "node scripts/check-locales.mjs",
    "check": "pnpm fmt:check && pnpm lint && pnpm typecheck && pnpm check:locales && pnpm check:index && pnpm test && pnpm build",
    "e2e": "pnpm build && playwright test",
    "release": "bash scripts/release",
    "verify": "bash scripts/verify",
    "update-check": "bash scripts/update-check",
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && lefthook install || true"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@tanstack/react-query": "^5.105.0",
    "@tanstack/react-router": "^1.170.46",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.66.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "use-intl": "^4.14.9",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-deb": "^8.0.1",
    "@electron-forge/maker-rpm": "^8.0.1",
    "@electron-forge/maker-dmg": "^8.0.1",
    "@electron-forge/maker-squirrel": "^8.0.1",
    "@electron-forge/maker-zip": "^8.0.1",
    "@electron-forge/plugin-fuses": "^8.0.1",
    "@electron-forge/plugin-vite": "^8.0.1",
    "@electron-forge/publisher-github": "^8.0.1",
    "@electron-forge/shared-types": "^8.0.1",
    "@electron/fuses": "^2.1.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@rolldown/plugin-babel": "^0.2.4",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "axe-core": "^4.14.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "electron": "45.2.1",
    "eslint": "^10.14.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.4.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "lefthook": "^2.2.2",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
